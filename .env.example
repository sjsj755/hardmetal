# 复制本文件为仓库根目录的 .env，按需修改；.env 已被 .gitignore 忽略，不会入库。
# 格式：KEY=VALUE，一行一个；不要加引号，不要留行尾空格。
# 读取方：application.yml 的 spring.config.import 会依次尝试 ./.env 与 ../.env，
#         所以从仓库根目录或 backend 目录启动都能生效；文件不存在时忽略。

# ---------- PostgreSQL ----------
DB_USER=hardmetal
DB_PASSWORD=change-me
# 可选，默认 jdbc:postgresql://127.0.0.1:5432/trade
# DB_URL=jdbc:postgresql://127.0.0.1:5432/trade

# ---------- Redis ----------
REDIS_PASSWORD=change-me
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ---------- JWT ----------
# 签名密钥，至少 32 字节；生产环境务必换成随机值（例如 openssl rand -base64 48）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes